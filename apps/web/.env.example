# Firebase web config (Project settings > Your apps). Not secret, but keep per environment.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Must match REGION in apps/functions/src/index.ts
VITE_FUNCTIONS_REGION=europe-west1
# true = use the local Firebase emulators (npm run emulators). No real project needed.
VITE_USE_EMULATORS=true
